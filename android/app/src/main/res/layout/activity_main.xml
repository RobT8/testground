<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <!-- ============================ CONFIG ERROR ============================ -->
        <LinearLayout
            android:id="@+id/configError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone"
            android:padding="16dp">
            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="⚙️" android:textSize="48sp"/>
            <TextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/not_configured"
                android:textColor="@color/ink" android:textSize="16sp"
                android:gravity="center"/>
        </LinearLayout>

        <!-- ============================ SETUP ============================ -->
        <LinearLayout
            android:id="@+id/setupPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="🔔 Night Alert" android:textSize="26sp"
                android:textStyle="bold" android:textColor="@color/ink"/>

            <TextView
                android:id="@+id/stepIndicator"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="STEP 1 OF 3"
                android:textColor="@color/faint" android:textSize="13sp"
                android:textStyle="bold" android:letterSpacing="0.12"/>

            <!-- ---- Step: your name ---- -->
            <LinearLayout android:id="@+id/stepName"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:layout_marginTop="8dp">
                <TextView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="What's your name?"
                    android:textColor="@color/ink" android:textSize="23sp" android:textStyle="bold"/>
                <TextView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Shown to the family so they know who sent an alert."
                    android:textColor="@color/muted" android:textSize="15sp"/>
                <EditText
                    android:id="@+id/inputName" style="@style/Field"
                    android:layout_marginTop="18dp"
                    android:inputType="textPersonName" android:hint="e.g. Rob"/>
            </LinearLayout>

            <!-- ---- Step: who is this phone for ---- -->
            <LinearLayout android:id="@+id/stepRole"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:layout_marginTop="8dp"
                android:visibility="gone">
                <TextView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Who is this phone for?"
                    android:textColor="@color/ink" android:textSize="23sp" android:textStyle="bold"/>
                <TextView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Tap the one that describes this phone."
                    android:textColor="@color/muted" android:textSize="15sp"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/roleSleeper" style="@style/RoleButton"
                    android:layout_marginTop="18dp"
                    android:text="🛏️  I am to be woken up\nThis phone rings &amp; shows my check-in buttons"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/roleCarer" style="@style/RoleButton"
                    android:text="📲  I am a carer\nI send the alerts &amp; see the reply"/>
            </LinearLayout>

            <!-- ---- Step: who are you helping (carer only) ---- -->
            <LinearLayout android:id="@+id/stepSleeper"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:layout_marginTop="8dp"
                android:visibility="gone">
                <TextView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Who are you helping?"
                    android:textColor="@color/ink" android:textSize="23sp" android:textStyle="bold"/>
                <TextView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="The person who gets woken and checks in. Their first name is enough."
                    android:textColor="@color/muted" android:textSize="15sp"/>
                <EditText
                    android:id="@+id/inputSleeper" style="@style/Field"
                    android:layout_marginTop="18dp"
                    android:inputType="textPersonName" android:hint="e.g. Linda"/>
            </LinearLayout>

            <!-- ---- Step: family group code ---- -->
            <LinearLayout android:id="@+id/stepGroup"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:layout_marginTop="8dp"
                android:visibility="gone">
                <TextView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Family group code"
                    android:textColor="@color/ink" android:textSize="23sp" android:textStyle="bold"/>
                <TextView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Everyone in the family enters the SAME code so your phones are linked. Pick something only you know."
                    android:textColor="@color/muted" android:textSize="15sp"/>
                <EditText
                    android:id="@+id/inputGroup" style="@style/Field"
                    android:layout_marginTop="18dp"
                    android:inputType="textCapCharacters" android:hint="e.g. SMITH-NIGHT"/>
            </LinearLayout>

            <TextView
                android:id="@+id/setupError"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/danger" android:textSize="14sp"
                android:visibility="gone"/>

            <!-- ---- Wizard navigation ---- -->
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_marginTop="28dp">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBack" style="@style/GhostButton"
                    android:layout_width="wrap_content"
                    android:text="Back" android:visibility="invisible"/>
                <View android:layout_width="0dp" android:layout_height="1dp"
                    android:layout_weight="1"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNext" style="@style/BigButton"
                    android:layout_width="wrap_content"
                    app:backgroundTint="@color/ok"
                    android:paddingHorizontal="44dp"
                    android:text="Next"/>
            </LinearLayout>
        </LinearLayout>

        <!-- ============================ CARER ============================ -->
        <LinearLayout
            android:id="@+id/carerPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:id="@+id/carerWho"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/faint" android:textSize="14sp"/>
                <Button android:id="@+id/carerChange" style="@style/LinkButton" android:text="Change"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/carerStatusBox"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:gravity="center"
                android:layout_marginTop="8dp" android:padding="22dp"
                android:background="@drawable/card">
                <TextView android:id="@+id/carerStatusEmoji"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="🟢" android:textSize="40sp"/>
                <TextView android:id="@+id/carerStatusTitle"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="All quiet" android:textColor="@color/ink"
                    android:textSize="22sp" android:textStyle="bold" android:layout_marginTop="4dp"/>
                <TextView android:id="@+id/carerStatusDetail"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="No active alert right now." android:gravity="center"
                    android:textColor="@color/muted" android:textSize="15sp" android:layout_marginTop="4dp"/>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnWake" style="@style/BigButton"
                app:backgroundTint="@color/danger"
                android:layout_marginTop="18dp"
                android:text="🔔  Send alert"/>

            <Button android:id="@+id/btnCancel" style="@style/GhostButton"
                android:text="Cancel this alert (false alarm)" android:visibility="gone"/>

            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="18dp" android:padding="14dp"
                android:background="@drawable/card">
                <LinearLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <LinearLayout
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView
                            android:id="@+id/pingTitle"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Ping me when they check in"
                            android:textColor="@color/ink" android:textSize="16sp" android:textStyle="bold"/>
                        <TextView
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Turn off when you're not on duty, so it won't wake you."
                            android:textColor="@color/muted" android:textSize="13sp"/>
                    </LinearLayout>
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchPing"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:checked="true"/>
                </LinearLayout>
                <TextView
                    android:id="@+id/pingState"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Currently ON"
                    android:textStyle="bold" android:textSize="15sp"
                    android:textColor="@color/ok"/>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="20dp" android:text="RECENT ACTIVITY"
                android:textColor="@color/faint" android:textSize="13sp" android:letterSpacing="0.08"/>
            <TextView android:id="@+id/carerLog"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:lineSpacingMultiplier="1.3"
                android:text="Nothing yet." android:textColor="@color/faint" android:textSize="14sp"/>
        </LinearLayout>

        <!-- ============================ SLEEPER ============================ -->
        <LinearLayout
            android:id="@+id/sleeperPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:id="@+id/sleeperWho"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/faint" android:textSize="14sp"/>
                <Button android:id="@+id/sleeperChange" style="@style/LinkButton" android:text="Change"/>
            </LinearLayout>

            <!-- Not armed yet -->
            <LinearLayout android:id="@+id/armPanel"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:gravity="center"
                android:layout_marginTop="20dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="🌙" android:textSize="52sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Ready for the night?" android:textColor="@color/ink"
                    android:textSize="24sp" android:textStyle="bold" android:layout_marginTop="8dp"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center" android:layout_marginTop="8dp"
                    android:text="Tap the button once. Then you can lock your phone and put it down — it will ring loudly if someone needs to wake you, even on silent."
                    android:textColor="@color/muted" android:textSize="16sp"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnArm" style="@style/BigButton"
                    app:backgroundTint="@color/ok" android:layout_marginTop="20dp"
                    android:text="✅  Arm for tonight"/>
                <Button android:id="@+id/btnTest" style="@style/GhostButton"
                    android:text="▶  Test the alarm sound"/>
            </LinearLayout>

            <!-- Armed -->
            <LinearLayout android:id="@+id/armedPanel"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:gravity="center"
                android:layout_marginTop="20dp" android:visibility="gone">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="🌙" android:textSize="52sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Always listening 💙" android:textColor="@color/ink"
                    android:textSize="24sp" android:textStyle="bold" android:layout_marginTop="8dp"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center" android:layout_marginTop="8dp"
                    android:text="Nothing to do before bed — this phone is always ready and will ring loudly if you're needed. Just keep it charged when you can."
                    android:textColor="@color/muted" android:textSize="16sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="14dp" android:text="🔔  Listening…"
                    android:textColor="@color/ok" android:textSize="18sp" android:textStyle="bold"
                    android:background="@drawable/pill" android:paddingHorizontal="20dp" android:paddingVertical="10dp"/>
                <Button android:id="@+id/btnTest2" style="@style/GhostButton"
                    android:text="▶  Test the alarm sound"/>
                <Button android:id="@+id/btnDisarm" style="@style/GhostButton"
                    android:text="Turn off for now"/>

                <TextView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="20dp" android:text="RECENT ACTIVITY"
                    android:textColor="@color/faint" android:textSize="13sp" android:letterSpacing="0.08"/>
                <TextView android:id="@+id/sleeperLog"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:lineSpacingMultiplier="1.3"
                    android:text="Nothing yet." android:textColor="@color/faint" android:textSize="14sp"/>
            </LinearLayout>
        </LinearLayout>

    </FrameLayout>
</ScrollView>
