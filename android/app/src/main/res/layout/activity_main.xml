<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <!-- ============================ CONFIG ERROR ============================ -->
        <LinearLayout
            android:id="@+id/configError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone"
            android:padding="16dp">
            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="⚙️" android:textSize="48sp"/>
            <TextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/not_configured"
                android:textColor="@color/ink" android:textSize="16sp"
                android:gravity="center"/>
        </LinearLayout>

        <!-- ============================ SETUP ============================ -->
        <LinearLayout
            android:id="@+id/setupPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="🔔 Night Alert" android:textSize="28sp"
                android:textStyle="bold" android:textColor="@color/ink"/>
            <TextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:layout_marginBottom="20dp"
                android:gravity="center"
                android:text="Wake-up alerts &amp; check-in confirmations."
                android:textColor="@color/muted" android:textSize="15sp"/>

            <TextView style="@style/FieldLabel" android:text="Your name"/>
            <EditText
                android:id="@+id/inputName" style="@style/Field"
                android:inputType="textPersonName" android:hint="e.g. Rob"/>

            <TextView style="@style/FieldLabel" android:text="Family group code"/>
            <EditText
                android:id="@+id/inputGroup" style="@style/Field"
                android:inputType="textCapCharacters" android:hint="e.g. SMITH-NIGHT"/>
            <TextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Everyone in the family types the SAME code. Pick something only you know."
                android:textColor="@color/muted" android:textSize="13sp"/>

            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="This phone is…"
                android:textColor="@color/ink" android:textSize="16sp" android:textStyle="bold"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/roleSleeper" style="@style/RoleButton"
                android:text="🛏️  Mum's phone\nThis phone rings &amp; shows the check-in button"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/roleCarer" style="@style/RoleButton"
                android:text="📲  A carer's phone\nI send the alerts &amp; watch for the reply"/>

            <TextView
                android:id="@+id/setupError"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/danger" android:textSize="14sp"
                android:visibility="gone"/>
        </LinearLayout>

        <!-- ============================ CARER ============================ -->
        <LinearLayout
            android:id="@+id/carerPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:id="@+id/carerWho"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/faint" android:textSize="14sp"/>
                <Button android:id="@+id/carerChange" style="@style/LinkButton" android:text="Change"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/carerStatusBox"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:gravity="center"
                android:layout_marginTop="8dp" android:padding="22dp"
                android:background="@drawable/card">
                <TextView android:id="@+id/carerStatusEmoji"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="🟢" android:textSize="40sp"/>
                <TextView android:id="@+id/carerStatusTitle"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="All quiet" android:textColor="@color/ink"
                    android:textSize="22sp" android:textStyle="bold" android:layout_marginTop="4dp"/>
                <TextView android:id="@+id/carerStatusDetail"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="No active alert right now." android:gravity="center"
                    android:textColor="@color/muted" android:textSize="15sp" android:layout_marginTop="4dp"/>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnWake" style="@style/BigButton"
                app:backgroundTint="@color/danger"
                android:layout_marginTop="18dp"
                android:text="🔔  Alert Mum"/>

            <Button android:id="@+id/btnCancel" style="@style/GhostButton"
                android:text="Cancel this alert (false alarm)" android:visibility="gone"/>

            <TextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="20dp" android:text="TONIGHT"
                android:textColor="@color/faint" android:textSize="13sp" android:letterSpacing="0.08"/>
            <TextView android:id="@+id/carerLog"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:lineSpacingMultiplier="1.3"
                android:text="Nothing yet." android:textColor="@color/faint" android:textSize="14sp"/>
        </LinearLayout>

        <!-- ============================ SLEEPER ============================ -->
        <LinearLayout
            android:id="@+id/sleeperPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:id="@+id/sleeperWho"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/faint" android:textSize="14sp"/>
                <Button android:id="@+id/sleeperChange" style="@style/LinkButton" android:text="Change"/>
            </LinearLayout>

            <!-- Not armed yet -->
            <LinearLayout android:id="@+id/armPanel"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:gravity="center"
                android:layout_marginTop="20dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="🌙" android:textSize="52sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Ready for the night?" android:textColor="@color/ink"
                    android:textSize="24sp" android:textStyle="bold" android:layout_marginTop="8dp"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center" android:layout_marginTop="8dp"
                    android:text="Tap the button once. Then you can lock your phone and put it down — it will ring loudly if someone needs to wake you, even on silent."
                    android:textColor="@color/muted" android:textSize="16sp"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnArm" style="@style/BigButton"
                    app:backgroundTint="@color/ok" android:layout_marginTop="20dp"
                    android:text="✅  Arm for tonight"/>
                <Button android:id="@+id/btnTest" style="@style/GhostButton"
                    android:text="▶  Test the alarm sound"/>
            </LinearLayout>

            <!-- Armed -->
            <LinearLayout android:id="@+id/armedPanel"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:gravity="center"
                android:layout_marginTop="20dp" android:visibility="gone">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="🌙" android:textSize="52sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Always listening 💙" android:textColor="@color/ink"
                    android:textSize="24sp" android:textStyle="bold" android:layout_marginTop="8dp"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center" android:layout_marginTop="8dp"
                    android:text="Nothing to do before bed — this phone is always ready and will ring loudly if you're needed. Just keep it charged when you can."
                    android:textColor="@color/muted" android:textSize="16sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="14dp" android:text="🔔  Listening…"
                    android:textColor="@color/ok" android:textSize="18sp" android:textStyle="bold"
                    android:background="@drawable/pill" android:paddingHorizontal="20dp" android:paddingVertical="10dp"/>
                <Button android:id="@+id/btnTest2" style="@style/GhostButton"
                    android:text="▶  Test the alarm sound"/>
                <Button android:id="@+id/btnDisarm" style="@style/GhostButton"
                    android:text="Turn off for now"/>

                <TextView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="20dp" android:text="TONIGHT"
                    android:textColor="@color/faint" android:textSize="13sp" android:letterSpacing="0.08"/>
                <TextView android:id="@+id/sleeperLog"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:lineSpacingMultiplier="1.3"
                    android:text="Nothing yet." android:textColor="@color/faint" android:textSize="14sp"/>
            </LinearLayout>
        </LinearLayout>

    </FrameLayout>
</ScrollView>
